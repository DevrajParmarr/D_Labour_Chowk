{
    frankenphp
}

# Root directory - serve index.php
/ {
    try_files /index.php
    php
}

# Handle all PHP files
*.php {
    try_files {path}
    php
}

# Handle static files in Shared directory
/Shared/* {
    try_files {path}
    file_server
}

# Handle static files in public directory
/public/* {
    try_files {path}
    file_server
}

# Handle static files (CSS, JS, images, etc.)
*.css *.js *.png *.jpg *.jpeg *.gif *.svg *.ico *.webp *.woff *.woff2 *.ttf *.eot {
    try_files {path}
    file_server
}

# Fallback - serve files directly
{
    file_server
}